# Kinoskop API — copy to .env and fill in. Never commit .env.
# TMDB v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_API_TOKEN=
# IGDB via Twitch (https://dev.twitch.tv/console) — required for games
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: OMDb (IMDb / Rotten Tomatoes / Metacritic ratings)
OMDB_API_KEY=
# Contact sent in the Wikidata User-Agent header (e-mail or URL)
WIKIDATA_CONTACT=
# Frontend origin allowed by CORS
WEB_ORIGIN=http://localhost:4200
# true only behind a reverse proxy (Render), so the rate limit sees the real client IP
TRUST_PROXY=false
# PORT (default 3000) is not set here: Nx loads .env into every task and Angular dev server would pick it up too.
CACHE_DB_PATH=./data/cache.sqlite
