# Kinoskop API – portable image (SPEC §8.4). Build from the repository root:
#   docker build -f apps/api/Dockerfile -t kinoskop-api .
FROM node:24-slim AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm nx build api --skip-nx-cache

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 CACHE_DB_PATH=/data/cache.sqlite
COPY --from=build /repo/dist/apps/api ./
COPY --from=build /repo/apps/api/src/assets ./assets
# dist/apps/api/package.json is generated by the build (generatePackageJson); npm runs native install scripts.
RUN npm install --omit=dev
VOLUME /data
EXPOSE 3000
CMD ["node", "main.js"]
